<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TelegramChatNavigator.Desktop.ViewModels" xmlns:core="using:TelegramChatNavigator.Core"
        x:Class="TelegramChatNavigator.Desktop.MainWindow" x:DataType="vm:MainViewModel"
        Title="Telegram Chat Navigator" Width="1380" Height="870" MinWidth="1060" MinHeight="680"
        Background="{DynamicResource PageBrush}" FontFamily="Arial">
  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <Border Background="#172B4D" Padding="22,16">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="4" Margin="0,0,20,0">
          <TextBlock Text="TELEGRAM CHAT NAVIGATOR" Foreground="#96C8F0" FontSize="11" LetterSpacing="2" />
          <TextBlock Text="{Binding Title}" Foreground="White" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Summary}" Foreground="#C5D6EB" FontSize="12" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="ЛОКАЛЬНЫЙ АРХИВ" Foreground="#96C8F0" VerticalAlignment="Center" FontSize="11" />
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Orientation="Horizontal" Classes="header-actions">
          <Button Name="OpenButton" Content="Открыть экспорт" Command="{Binding OpenCommand}" IsEnabled="{Binding IsReady}" Classes="primary" Margin="0,0,6,0" />
          <Button Content="Демо" Command="{Binding DemoCommand}" IsEnabled="{Binding IsReady}" Margin="0,0,6,0" />
          <Button Content="Сохранить" Command="{Binding SaveCommand}" IsEnabled="{Binding IsReady}" Margin="0,0,6,0" />
          <Button Content="Загрузить" Command="{Binding LoadCommand}" IsEnabled="{Binding IsReady}" Margin="0,0,6,0" />
          <Button Content="Экспорт CSV" Command="{Binding ExportCommand}" IsEnabled="{Binding IsReady}" Margin="0,0,6,0" />
          <Button Content="Папка медиа" Command="{Binding RelocateCommand}" IsEnabled="{Binding IsReady}" Margin="0,0,6,0" />
          <Button Content="Справка · F1" Command="{Binding HelpCommand}" />
        </WrapPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="230,*,340" Margin="14" ColumnSpacing="12">
      <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8" Margin="0,0,10,0" IsEnabled="{Binding IsReady}">
            <TextBlock Text="Навигация" Classes="section" Margin="0,0,0,5" />
            <TextBlock Text="Искать в переписке" Classes="caption" />
            <TextBox Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="Текст, ссылка, имя файла" />
            <TextBlock Text="Тип сообщения" Classes="caption" />
            <ComboBox Name="KindBox" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Участники · авторы сообщений" Classes="caption" TextWrapping="Wrap" />
            <ComboBox Name="ParticipantBox" ItemsSource="{Binding Participants}" SelectedItem="{Binding SelectedParticipant}" HorizontalAlignment="Stretch" MaxDropDownHeight="320">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="core:Participant"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Период включительно" Classes="caption" Margin="0,5,0,0" />
            <TextBox Text="{Binding FromText}" PlaceholderText="С: yyyy-MM-dd" />
            <TextBox Text="{Binding ToText}" PlaceholderText="По: yyyy-MM-dd" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <Button Name="ApplyButton" Content="Найти" Command="{Binding ApplyCommand}" Background="#2779BC" Foreground="White" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="Сброс" Command="{Binding ResetCommand}" HorizontalAlignment="Stretch" />
            </Grid>
            <Border Height="1" Background="{DynamicResource PageBrush}" Margin="0,7" />
            <TextBlock Text="Быстрый переход" Classes="section" />
            <TextBox Text="{Binding JumpText}" PlaceholderText="yyyy-MM-dd" />
            <Button Content="К дате" Command="{Binding JumpCommand}" HorizontalAlignment="Stretch" />
            <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" HorizontalAlignment="Stretch" />
            <Button Content="К месяцу" Command="{Binding MonthCommand}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Переход по дате снимает фильтры и выбирает первое следующее сообщение." Classes="caption" TextWrapping="Wrap" Margin="0,2" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,10">
          <TextBlock Text="Переписка" Classes="section" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding PageLabel}" Classes="caption" VerticalAlignment="Center" />
        </Grid>
        <ListBox Name="MessageList" Grid.Row="1" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" FontSize="{Binding MessageFontSize}"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsReady}">
          <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:ChatMessage">
              <Border Background="{DynamicResource BubbleBrush}" CornerRadius="10" Padding="14,10" Margin="0,3,8,3">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" Foreground="{DynamicResource SenderBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Text}" IsVisible="{Binding HasText}" TextWrapping="Wrap" MaxHeight="150" ClipToBounds="True" />
                  <TextBlock Text="{Binding AttachmentLabel}" IsVisible="{Binding HasAttachments}" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Poll.Question}" IsVisible="{Binding HasPoll}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DateLabel}" Classes="caption" HorizontalAlignment="Right" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
          <Button Content="← Назад" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding IsReady}" />
          <TextBlock Grid.Column="1" Text="По 50 сообщений" Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="Далее →" Command="{Binding NextPageCommand}" IsEnabled="{Binding IsReady}" />
        </Grid>
      </Grid>
      <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10" Margin="0,0,10,0">
            <TextBlock Text="Сообщение и вложения" Classes="section" />
            <TextBlock Text="{Binding SelectedHeading}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedMessage.DateLabel}" Classes="caption" />
            <WrapPanel>
              <Button Content="Контекст" Command="{Binding ContextCommand}" IsEnabled="{Binding IsReady}" Margin="0,0,6,0" />
              <Button Content="К ответу" Command="{Binding ReplyCommand}" IsEnabled="{Binding IsReady}" />
            </WrapPanel>
            <SelectableTextBlock Name="FullMessageText" Text="{Binding SelectedMessage.Text}" FontSize="{Binding MessageFontSize}" TextWrapping="Wrap" />
            <SelectableTextBlock Text="{Binding SelectedMessage.PollText}" IsVisible="{Binding SelectedMessage.HasPoll}" TextWrapping="Wrap" />
            <TextBlock Text="Вложения" Classes="caption" />
            <ComboBox Name="AttachmentBox" ItemsSource="{Binding Attachments}" SelectedItem="{Binding SelectedAttachment}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="core:Attachment"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Image Source="{Binding PreviewImage}" MaxHeight="260" Stretch="Uniform" />
            <TextBlock Text="{Binding PreviewNote}" Classes="caption" TextWrapping="Wrap" />
            <Button Content="Предпросмотр macOS" Command="{Binding PreviewCommand}" IsEnabled="{Binding IsReady}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Ссылки · HTTP / HTTPS" Classes="caption" Margin="0,6,0,0" />
            <ComboBox ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Открыть в браузере ↗" Command="{Binding LinkCommand}" IsEnabled="{Binding IsReady}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Предпросмотр медиа работает с файлами из папки экспорта. Опрос показывает сохранённые результаты." Classes="caption" TextWrapping="Wrap" Margin="0,5,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource CardBrush}" Padding="16,8">
      <Grid ColumnDefinitions="Auto,110,Auto,80,Auto,*" ColumnSpacing="10">
        <TextBlock Text="Тема" VerticalAlignment="Center" Classes="caption" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch" />
        <TextBlock Grid.Column="2" Text="Текст" VerticalAlignment="Center" Classes="caption" />
        <ComboBox Grid.Column="3" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding MessageFontSize}" HorizontalAlignment="Stretch" />
        <Button Grid.Column="4" Content="Сохранить настройки" Command="{Binding PreferencesCommand}" IsEnabled="{Binding IsReady}" />
        <TextBlock Grid.Column="5" Text="{Binding Activity}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
      </Grid>
    </Border>
    <StackPanel Grid.Row="3">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
      <TextBlock Name="StatusText" Text="{Binding Status}" Classes="caption" Margin="16,8" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
